{
  "name": "web-turismo-admin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "scripts": {
    "openspec": "node scripts/openspec.mjs",
    "knowledge:init": "bun run openspec init --tools codex,claude --profile custom --language Spanish --no-animation",
    "knowledge:update": "bun run openspec update --force",
    "prepare:workers": "bun scripts/build-ficha-worker.ts",
    "predev": "bun run prepare:workers && node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev --port 3002",
    "prebuild": "bun run prepare:workers && node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "next start --port 3002",
    "format": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun run prepare:workers && bun test",
    "test:browser": "playwright test",
    "verify": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@mui/x-charts": "8.29.3",
    "@mui/x-data-grid": "8.29.3",
    "@tanstack/react-query": "^5.90.12",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "maplibre-gl": "^6.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.67.0",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "uuid": "11.1.1"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
