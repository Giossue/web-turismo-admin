index 0000000000000000000000000000000000000000..01cd07f84cf2e09dc14ebdeeb026096ab813cf93
--- /dev/null
+++ b/lib/validate-depth.js
@@ -0,0 +1,17 @@
+'use strict';
+
+// Iterative validation also protects public methods that accept a caller AST.
+module.exports = ast => {
+  const stack = [[ast, 0]];
+  const seen = new Set();
+  while (stack.length) {
+    const [node, depth] = stack.pop();
+    if (depth >= 256 || seen.has(node)) {
+      throw new RangeError('Brace nesting exceeds the safe limit (256)');
+    }
+    seen.add(node);
+    if (node.nodes) {
+      for (const child of node.nodes) stack.push([child, depth + 1]);
+    }
+  }
+};
